+// shUMEM (CLAUDE.md 21): with PCM_NO_SPEEDUP_AFFINITY set, the per-socket
+// "speedup trick" does not migrate the thread to the socket reference core
+// (the last CPU of the socket, an isolated polling lcore when the NIC socket
+// is full of lcores); the MSR reads then reach that CPU by a short IPI.
+class SpeedupThreadAffinity
+{
+    std::unique_ptr<TemporalThreadAffinity> aff;
+public:
+    SpeedupThreadAffinity(uint32 core_id, bool checkStatus = true)
+    {
+        static const bool skip = std::getenv("PCM_NO_SPEEDUP_AFFINITY") != nullptr;
+        if (!skip) aff.reset(new TemporalThreadAffinity(core_id, checkStatus));
+    }
+};
